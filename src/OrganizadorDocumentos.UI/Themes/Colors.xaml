<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="BgNavy">#0B132B</Color>

    <SolidColorBrush x:Key="TextPrimary" Color="#F2F5FA" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA7C0" />
    <SolidColorBrush x:Key="GlassBorder" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="GlassHover" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#2ECC71" />
    <SolidColorBrush x:Key="Warning" Color="#F5A623" />
    <SolidColorBrush x:Key="Danger" Color="#FF5C5C" />
    <SolidColorBrush x:Key="Accent" Color="#3A86FF" />
    <SolidColorBrush x:Key="SectionTitle" Color="#8AB4FF" />

    <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#24FFFFFF" Offset="0" />
        <GradientStop Color="#0AFFFFFF" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>