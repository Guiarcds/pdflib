<Application x:Class="OrganizadorDocumentos.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:OrganizadorDocumentos.UI.Converters"
             xmlns:vm="clr-namespace:OrganizadorDocumentos.UI.ViewModels"
             xmlns:views="clr-namespace:OrganizadorDocumentos.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Cards.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <ResourceDictionary Source="Themes/DataGrid.xaml" />
                <ResourceDictionary Source="Themes/Lists.xaml" />
                <ResourceDictionary Source="Themes/ComboBox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:FileNameConverter x:Key="FileNameConverter"/>
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
            <converters:PercentToScaleConverter x:Key="PercentToScaleConverter"/>
            <converters:ImageToVisibilityConverter x:Key="ImageToVisibilityConverter"/>
            <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>

            <DataTemplate DataType="{x:Type vm:VisaoGeralViewModel}">
                <views:VisaoGeralView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProcessamentoViewModel}">
                <views:ProcessamentoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RevisaoViewModel}">
                <views:RevisaoView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfiguracaoViewModel}">
                <views:ConfiguracaoView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
