<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrganizadorDocumentos.Core\OrganizadorDocumentos.Core.csproj" />
    <ProjectReference Include="..\OrganizadorDocumentos.Data\OrganizadorDocumentos.Data.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\bin\</OutputPath>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)$(TargetName).exe" DestinationFolder="..\..\bin\" SkipUnchangedFiles="true" />
  </Target>

</Project>
