<UserControl x:Class="OrganizadorDocumentos.UI.Views.ProcessamentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Processamento de Documentos" Style="{StaticResource HeaderTextStyle}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Button Content="Processar Agora" Command="{Binding ProcessarCommand}"
                        Style="{StaticResource SuccessButtonStyle}"/>
                <Button Content="Atualizar Lista" Command="{Binding AtualizarListaCommand}"
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>

            <ProgressBar Value="{Binding Progresso}" Height="20" Margin="0,0,0,10"
                         Visibility="{Binding Processando, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="{Binding ArquivoAtual}" Margin="0,0,0,20"
                       Visibility="{Binding Processando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Pendentes" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalArquivos}" FontSize="24" FontWeight="Bold"
                                   Foreground="#3498DB"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Processados" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding Processados}" FontSize="24" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Revisar" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding Revisar}" FontSize="24" FontWeight="Bold"
                                   Foreground="#F39C12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Erros" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding Erros}" FontSize="24" FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Arquivos na Pasta de Entrada" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <ListBox ItemsSource="{Binding ArquivosPendentes}" MaxHeight="150"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource FileNameConverter}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding Resultados.Count, Converter={StaticResource CountToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Resultados do Processamento" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding Resultados}" MaxHeight="200"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Arquivo" DisplayMemberBinding="{Binding ArquivoOrigem, Converter={StaticResource FileNameConverter}}" Width="150"/>
                                <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="80"/>
                                <GridViewColumn Header="Destino" DisplayMemberBinding="{Binding CaminhoDestino}" Width="300"/>
                                <GridViewColumn Header="Mensagem" DisplayMemberBinding="{Binding Mensagem}" Width="200"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
