<UserControl x:Class="OrganizadorDocumentos.UI.Views.VisaoGeralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Visão Geral" Style="{StaticResource HeaderTextStyle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Documentos Processados" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalProcessados}" FontSize="36" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Em Revisão" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalRevisar}" FontSize="36" FontWeight="Bold"
                                   Foreground="#F39C12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Erros" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalErros}" FontSize="36" FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Informações do Sistema" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding UltimaAtualizacao, StringFormat='Última atualização: {0}'}"
                               Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </Border>

            <Separator Background="#D5D8DC" Margin="10,15"/>

            <TextBlock Text="Mapeamento da Estrutura" Style="{StaticResource HeaderTextStyle}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Colaboradores" Style="{StaticResource LabelTextStyle}"/>
                    <TextBlock Text="{Binding Mapeamento.TotalColaboradores}" FontSize="36" FontWeight="Bold"
                               Foreground="#3498DB"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="[ Atualizar estrutura ]"
                        Command="{Binding Mapeamento.AtualizarEstruturaCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        IsEnabled="{Binding Mapeamento.Mapeando, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Content="[ Unificar ]"
                        Command="{Binding Mapeamento.UnificarCommand}"
                        Style="{StaticResource WarningButtonStyle}"
                        IsEnabled="{Binding Mapeamento.PodeUnificar}"
                        ToolTip="Move todo o conteúdo de um colaborador para outro e exclui a pasta de origem"/>
                <TextBlock Text="{Binding Mapeamento.StatusMapeamento}" VerticalAlignment="Center" Margin="15,0,0,0"
                           Foreground="#7F8C8D"/>
            </StackPanel>

            <TextBlock Text="{Binding Mapeamento.StatusUnificacao}" TextWrapping="Wrap"
                       Foreground="#7F8C8D" Margin="10,0,10,20"/>

            <ProgressBar IsIndeterminate="{Binding Mapeamento.Mapeando}" Height="5" Margin="0,0,0,20"
                         Visibility="{Binding Mapeamento.Mapeando, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Colaboradores Mapeados" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding Mapeamento.Colaboradores}" MaxHeight="300"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Pasta" DisplayMemberBinding="{Binding NomePasta}" Width="200"/>
                                <GridViewColumn Header="Nome Normalizado" DisplayMemberBinding="{Binding NomeNormalizado}" Width="200"/>
                                <GridViewColumn Header="Anos" DisplayMemberBinding="{Binding Anos.Count}" Width="80"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
