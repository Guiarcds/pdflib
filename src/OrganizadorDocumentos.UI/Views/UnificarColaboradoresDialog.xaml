<Window x:Class="OrganizadorDocumentos.UI.Views.UnificarColaboradoresDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unificar colaboradores"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal">

    <Border Margin="14"
            Background="{StaticResource BgNavyBrush}"
            BorderBrush="{StaticResource GlassBorder}"
            BorderThickness="1"
            CornerRadius="12">

        <StackPanel>

            <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Unificar colaboradores"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>

                <Button Grid.Column="1"
                        Width="40"
                        Height="30"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource TextPrimary}"
                        Cursor="Hand"
                        ToolTip="Fechar"
                        Click="Fechar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}">
                                <Path x:Name="IconX"
                                      Data="M0,0 L10,10 M10,0 L0,10"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#FF5C5C" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Border Height="1" Background="{StaticResource GlassBorder}" />

            <ScrollViewer CanContentScroll="False" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Margin="24,18,24,18">

                <TextBlock Text="Unificar pastas de colaboradores"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Todo o conteúdo da pasta de origem será movido para a pasta de destino, preservando a estrutura de anos e meses. A pasta de origem será excluída."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="13"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Colaborador de origem (será removido)"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="OrigemCombo"
                          ItemsSource="{Binding}"
                          DisplayMemberPath="NomePasta"
                          SelectionChanged="OrigemCombo_SelectionChanged"
                          Padding="12,0"
                          MinHeight="34"
                          Margin="0,0,0,16"/>

                <TextBlock Text="Colaborador de destino (receberá os arquivos)"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="DestinoCombo"
                          ItemsSource="{Binding}"
                          DisplayMemberPath="NomePasta"
                          SelectionChanged="DestinoCombo_SelectionChanged"
                          Padding="12,0"
                          MinHeight="34"
                          Margin="0,0,0,16"/>

                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <TextBlock x:Name="ResumoTextBlock"
                               TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimary}"/>
                </Border>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Cancelar" Width="110" Height="36" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Cancelar_Click" IsCancel="True"/>
                    <Button Content="Unificar" Width="130" Height="36"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="Confirmar_Click" IsDefault="True"/>
                </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
