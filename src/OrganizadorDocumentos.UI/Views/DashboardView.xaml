<UserControl x:Class="OrganizadorDocumentos.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Dashboard" Style="{StaticResource HeaderTextStyle}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Documentos Processados" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalProcessados}" FontSize="36" FontWeight="Bold"
                                   Foreground="#27AE60"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Em Revisão" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalRevisar}" FontSize="36" FontWeight="Bold"
                                   Foreground="#F39C12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Erros" Style="{StaticResource LabelTextStyle}"/>
                        <TextBlock Text="{Binding TotalErros}" FontSize="36" FontWeight="Bold"
                                   Foreground="#E74C3C"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Informações do Sistema" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding UltimaAtualizacao, StringFormat='Última atualização: {0}'}"
                               Style="{StaticResource ValueTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Regra Principal" FontSize="16" FontWeight="Bold"
                               Foreground="#2C3E50" Margin="0,0,0,10"/>
                    <TextBlock Text="NÃO CRIAR SE JÁ EXISTIR" FontSize="18" FontWeight="Bold"
                               Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,5"/>
                    <TextBlock Text="O sistema preserva a estrutura existente e cria apenas o que estiver ausente."
                               TextWrapping="Wrap" Foreground="#7F8C8D" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
