<Window x:Class="OrganizadorDocumentos.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OrganizadorDocumentos.UI.ViewModels"
        xmlns:views="clr-namespace:OrganizadorDocumentos.UI.Views"
        mc:Ignorable="d"
        Title="{Binding Titulo}" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#1A252F" Padding="15,20">
                    <TextBlock Text="Organizador de Documentos"
                               Foreground="White" FontSize="14" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                    <TextBlock Text="{Binding StatusSistema, StringFormat='Status: {0}'}"
                               Foreground="#BDC3C7" FontSize="11" Margin="15,0,0,5"
                               HorizontalAlignment="Left"/>
                </StackPanel>

                <StackPanel Margin="0,20,0,0">
                    <Button Content="Dashboard" Command="{Binding NavegarDashboardCommand}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                    <Button Content="Mapeamento" Command="{Binding NavegarMapeamentoCommand}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                    <Button Content="Processamento" Command="{Binding NavegarProcessamentoCommand}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                    <Button Content="Revisão" Command="{Binding NavegarRevisaoCommand}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                    <Button Content="Configurações" Command="{Binding NavegarConfiguracaoCommand}"
                            Style="{StaticResource MenuButtonStyle}" Margin="0,2"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentArea" Grid.Column="1"/>
    </Grid>
</Window>
